[Connection]
host = 127.0.0.1
port = 25565
username = Bot

[Scene]
data_file = example_scene.json

[LLM]
model_name = deepseek-flash
# Maximum LLM generations per user message (tool call loop limit)
max_tool_subturns = 10
# Thinking mode: enabled or disabled
thinking = enabled
# Reasoning effort: low, high or max
reasoning_effort = low

[LLMClient]
baseURL = https://api.deepseek.com/v1
apiKey = your_api_key_here
# timeout = 60
# maxRetries = 2
# defaultHeaders = {"X-Example": "value"}
